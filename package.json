{
  "name": "gamecrafter",
  "private": true,
  "workspaces": [
    "packages/*",
    "packages/plugins/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "build": "turbo run build --filter=\"./packages/*\"",
    "postbuild": "node scripts/prune-build-cache.cjs --apply",
    "build:apps": "turbo run build --filter=\"./apps/*\"",
    "postbuild:apps": "node scripts/prune-build-cache.cjs --apply",
    "cache:prune": "node scripts/prune-build-cache.cjs",
    "test:cache-maintenance": "node --test scripts/prune-build-cache.test.cjs",
    "download:plugins": "npm run download:plugins -w @gamecrafter/control-room",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:ui": "node scripts/live-ui-smoke.cjs",
    "test:ui:settings-models": "node scripts/settings-models-ui-smoke.cjs",
    "test:ui:chat-layout": "node scripts/chat-layout-ui-smoke.cjs",
    "format": "node node_modules/prettier/bin/prettier.cjs --write .",
    "format:check": "node node_modules/prettier/bin/prettier.cjs --check .",
    "release:version": "node scripts/set-release-version.cjs",
    "changelog:update": "node scripts/change-tracking.cjs update",
    "changelog:check": "node scripts/change-tracking.cjs check",
    "test:changes": "vitest run scripts/change-tracking.test.ts --maxWorkers=1",
    "postinstall": "patch-package --error-on-fail"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.8",
    "puppeteer": "25.1.0",
    "turbo": "2.11.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1",
    "patch-package": "8.0.1"
  },
  "allowScripts": {
    "@theia/ffmpeg@1.75.0": true,
    "puppeteer@25.1.0": true,
    "esbuild@0.28.2": true,
    "@parcel/watcher@2.6.0": true,
    "drivelist@12.0.2": true,
    "@vscode/windows-ca-certs@0.3.4": true,
    "electron-winstaller@5.4.0": true,
    "keytar@7.9.0": true,
    "native-keymap@2.5.0": true,
    "node-pty@1.2.0-beta.12": true,
    "msgpackr-extract@3.0.4": true
  },
  "overrides": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "serialize-javascript": "7.0.7",
    "electron": "42.10.0",
    "decompress": "$decompress",
    "dompurify": "3.4.16",
    "http-cache-semantics": "4.3.0",
    "source-map-js": "1.2.2",
    "diff": "8.0.4",
    "uuid": "11.1.1",
    "@tootallnate/once": "2.0.1"
  },
  "dependencies": {
    "decompress": "file:./packages/archive-extractor"
  }
}
